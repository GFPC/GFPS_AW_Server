# Copy to .env and adjust. Loaded automatically from the repository root
# (or set GFPS_ENV_FILE=/absolute/path/.env). Values already set in the
# environment (e.g. systemd Environment=) are not overwritten.

# --- HTTP (production / server) ---
GFPS_HOST=127.0.0.1
GFPS_PORT=5700
GFPS_STORAGE=mysql
# В продакшене укажите конкретные origin-ы фронта; * удобно только для разработки
GFPS_CORS_ORIGINS=*
GFPS_BRONEVIK_URL=https://ibronevik.ru/taxi/c/0/api/v1/

# --- MySQL (production) ---
GFPS_MYSQL_HOST=localhost
GFPS_MYSQL_PORT=3306
GFPS_MYSQL_USER=root
GFPS_MYSQL_PASSWORD=
GFPS_MYSQL_DATABASE=activitywatch

# --- HTTP (--testing) ---
GFPS_TESTING_HOST=localhost
GFPS_TESTING_PORT=5777
GFPS_TESTING_STORAGE=mysql
GFPS_TESTING_CORS_ORIGINS=*
GFPS_TESTING_BRONEVIK_URL=https://ibronevik.ru/taxi/c/0/api/v1/

# --- MySQL (testing); falls back to GFPS_MYSQL_* if omitted ---
# GFPS_TESTING_MYSQL_HOST=localhost
# GFPS_TESTING_MYSQL_PORT=3306
# GFPS_TESTING_MYSQL_USER=root
# GFPS_TESTING_MYSQL_PASSWORD=
GFPS_TESTING_MYSQL_DATABASE=activitywatch_test
